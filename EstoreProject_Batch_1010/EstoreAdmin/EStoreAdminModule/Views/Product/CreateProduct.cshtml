@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using EstoreModel.Models.Products;
@using EstoreModel.Models.Brands;
@using EstoreModel.Models.Types;
@model CreateProductModel;

@{
    List<BrandModel> brands = ViewBag.Brands;
    List<TypeModel> types = ViewBag.Types;
}

<html>
<head>
    <title>Create Product</title>
    <link href="~/bootstrap/css/bootstrap.css" rel="stylesheet" />
</head>

<body>
    <div class="container">
        <div class="col-lg-8 mx-auto rounder border p-3 mt-3">
            <div class="row mt-2">
                <div class="h1 text-center text-bg-primary">
                    Create Product
                </div>
            </div>

            <form method="post" enctype="multipart/form-data">

                <div class="row mt-3">
                    <div class="col-lg-4 col-sm-4 col-md-4">
                        <label asp-for="ProductName">Product Name</label>
                    </div>
                    <div class="col-lg-4 col-sm-4 col-md-4">
                        <input type="text" class="form-control" asp-for="ProductName" />
                    </div>
                </div>

                <div class="row mt-3">
                    <div class="col-lg-4 col-sm-4 col-md-4">
                        <label asp-for="ProductDescription">Product Description</label>
                    </div>
                    <div class="col-lg-4 col-sm-4 col-md-4">
                        <textarea class="form-control" asp-for="ProductDescription"></textarea>
                    </div>
                </div>

                <div class="row mt-3">
                    <div class="col-lg-4 col-sm-4 col-md-4">
                        <label asp-for="BrandId">Brand Name</label>
                    </div>
                    <div class="col-lg-4 col-sm-4 col-md-4">
                        <select type="select" class="form-control" asp-for="BrandId">
                            <option value="0">--Select Brand--</option>
                            @foreach (var brand in brands)
                            {
                                <option value="@brand.Id">@brand.Name</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="row mt-3">
                    <div class="col-lg-4 col-sm-4 col-md-4">
                        <label asp-for="TypeId">Type Name</label>
                    </div>
                    <div class="col-lg-4 col-sm-4 col-md-4">
                        <select type="select" class="form-control" asp-for="TypeId">
                            <option value="0">--Select Type--</option>
                            @foreach (var type in types)
                            {
                                <option value="@type.Id">@type.Name</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="row mt-3">
                    <div class="col-lg-4 col-sm-4 col-md-4">
                        <label asp-for="UploadImage">Product Image</label>
                    </div>
                    <div class="col-lg-4 col-sm-4 col-md-4">
                        <input type="file" class="form-control" asp-for="UploadImage" />
                    </div>
                </div>

                <div class="row mt-3">
                    <div class="col-lg-4 col-sm-4 col-md-4">
                        <label asp-for="ProductPrice">Product Cost</label>
                    </div>
                    <div class="col-lg-4 col-sm-4 col-md-4">
                        <input type="number" class="form-control" asp-for="ProductPrice" />
                    </div>
                </div>

                <div class="row mt-3">
                    <div class="col-lg-4">
                    </div>

                    <div class="col-lg-4">
                        <button class="btn btn-outline-primary m-4"
                                asp-controller="Product"
                                asp-action="CreateProduct">
                            Submit
                        </button>
                        <a class="btn btn-outline-secondary">
                            Cancel
                        </a>
                    </div>
                </div>

            </form>
        </div>
    </div>

</body>
</html>
