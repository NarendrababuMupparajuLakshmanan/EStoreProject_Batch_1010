@using EstoreModel.Models.Products;
@model IEnumerable<ProductModel>;

<html>
<head>
    <title>List of Products</title>
    <link href="~/bootstrap/css/bootstrap.css" rel="stylesheet" />

</head>
<body>
    <div class="container">
        <div class="row">
            <div class="h1 text-center bg-primary text-white mt-3">
                List of Products
            </div>
        </div>

        <div class="row mt-3">
            <div class="col-md-3 col-lg-3 col-sm-3">
                <a class="btn btn-outline-primary"
                   asp-controller="Product"
                   asp-action="CreateProduct">
                    Create Product
                </a>
            </div>
        </div>

        <div class="row mt-3">
            <table class="table table-primary table-hover">
                <thead>
                    <tr>
                        <td>Product Id</td>
                        <td>Product Name</td>
                        <td>Product Description</td>
                        <td>Brand Name</td>
                        <td>Type Name</td>
                        <td>Product Image </td>
                        <td>Price</td>
                        <td>Total Price</td>
                        <td>Edit</td>
                        <td>Delete</td>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.Count() == 0)
                    {
                        <tr>
                            <td colspan="10">
                                <div class="h3 text-bg-danger text-center">
                                    There is no Products Available
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (ProductModel productModel in Model)
                        {
                            <tr>
                                <td>@productModel.Id</td>
                                <td>@productModel.ProductName</td>
                                <td>@productModel.ProductDescription</td>
                                <td>@productModel.ImageName</td>
                                <td>@productModel.BrandId</td>
                                <td>@productModel.TypeId</td>
                                <td>@productModel.Price</td>
                                <td>@productModel.TotalCost</td>
                                <td>
                                    <a class="btn btn-outline-secondary"
                                       asp-controller="Brand"
                                       asp-action="EditBrand"
                                       asp-route-Id="@productModel.Id">Edit</a>
                                </td>
                                <td>
                                    <a class="btn btn-outline-danger"
                                       asp-controller="Brand"
                                       asp-action="DeleteBrand"
                                       asp-route-Id="@productModel.Id">Delete</a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</body>
</html>