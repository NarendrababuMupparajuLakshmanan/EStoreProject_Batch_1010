@using EstoreModel.Models.Brands
@model List<BrandModel>;

<html>
<head>
    <title>List of Brands</title>
    <link href="~/bootstrap/css/bootstrap.css" rel="stylesheet" />

</head>
<body>
    <div class="container">
        <div class="row">
            <div class="h1 text-center bg-primary mt-3">
                List of Brands
            </div>
            <div class="row mt-5">
                <table class="table table-primary table-hover">
                    <thead>
                        <tr>
                            <td>Brand Id</td>
                            <td>Brand Name</td>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (BrandModel brandModel in Model)
                        {
                            <tr>
                                <td>@brandModel.Id</td>
                                <td>@brandModel.Name</td>
                            </tr>
                        }

                    </tbody>
                </table>
            </div>
        </div>
    </div>
  
   
    
</body>
</html>