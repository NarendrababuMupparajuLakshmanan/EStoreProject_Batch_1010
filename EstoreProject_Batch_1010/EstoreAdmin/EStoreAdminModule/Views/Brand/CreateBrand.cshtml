@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using EstoreModel.Models.Brands
@model CreateBrandModel;

<html>
<head>
    <title>List of Brands</title>
    <link href="~/bootstrap/css/bootstrap.css" rel="stylesheet" />

</head>
<body>
    <div class="container">
        <div class="row">
           
            <form method="post" enctype="multipart/form-data">
                <div class="col-lg-8 mx-auto rounder border p-3 mt-3">
                    <div class="h1 text-center bg-primary text-white mt-3">
                        Create Brand
                    </div>

                    <div class="row mt-3">
                        <div class="col-lg-4 col-sm-4 col-md-4">
                            <label asp-for="Name">Brand Name</label>
                        </div>
                        <div class="col-lg-4 col-sm-4 col-md-4">
                            <input type="text" class="form-control" asp-for="Name" />
                        </div>
                    </div>

                    <div class="row mt-3">
                        <div class="col-lg-4">
                        </div>

                        <div class="col-lg-4">
                            <button class="btn btn-outline-primary m-4"
                                    asp-controller="Brand"
                                    asp-action="CreateBrand">
                                Submit
                            </button>
                            <a class="btn btn-outline-secondary">
                                Cancel
                            </a>
                        </div>
                    </div>

                </div>
            </form>

            
        </div>
    </div>

  
   
</body>
</html>