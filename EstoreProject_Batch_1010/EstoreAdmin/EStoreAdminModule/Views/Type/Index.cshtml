@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using EstoreModel.Models.Types
@model List<TypeModel>;

<html>
<head>
    <title>List of Types</title>
    <link href="~/bootstrap/css/bootstrap.css" rel="stylesheet" />

</head>
<body>
    <div class="container">
        <div class="row">
            <div class="h1 text-center bg-primary text-white mt-3">
                List of Types
            </div>

            <div class="row mt-3">
                <div class="col-md-3 col-lg-3 col-sm-3">
                    <a class="btn btn-outline-primary"
                       asp-controller="Type"
                       asp-action="CreateType">
                        Create Type
                    </a>
                </div>
            </div>

            <div class="row mt-3">
                <table class="table table-primary table-hover">
                    <thead>
                        <tr>
                            <td>Type Id</td>
                            <td>Type Name</td>
                            <td>Edit</td>
                            <td>Delete</td>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model.Count == 0)
                        {
                            <tr>
                                <td colspan="4">
                                    <div class="h3 text-bg-danger text-center">
                                        There is no Types Available
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (TypeModel typeModel in Model)
                            {
                                <tr>
                                    <td>@typeModel.Id</td>
                                    <td>@typeModel.Name</td>
                                    <td>
                                        <a class="btn btn-outline-secondary"
                                           asp-controller="Type"
                                           asp-action="EditType"
                                           asp-route-Id="@typeModel.Id">Edit</a>
                                    </td>
                                    <td>
                                        <a class="btn btn-outline-danger"
                                           asp-controller="Type"
                                           asp-action="DeleteType"
                                           asp-route-Id="@typeModel.Id">Delete</a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

  
   
</body>
</html>