@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using EstoreModel.Models.Types
@model CreateTypeModel;

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="row">

    <form method="post" enctype="multipart/form-data">
        <div class="col-lg-8 mx-auto rounder border p-3 mt-3">
            <div class="h1 text-center bg-primary text-white mt-3">
                Create Type
            </div>

            <div class="row mt-3">
                <div class="col-lg-4 col-sm-4 col-md-4">
                    <label asp-for="Name">Type Name</label>
                </div>
                <div class="col-lg-4 col-sm-4 col-md-4">
                    <input type="text" class="form-control" asp-for="Name" />
                </div>
            </div>

            <div class="row mt-3">
                <div class="col-lg-4">
                </div>

                <div class="col-lg-4">
                    <button class="btn btn-outline-primary m-4"
                            asp-controller="Type"
                            asp-action="CreateType">
                        Submit
                    </button>
                    <a class="btn btn-outline-secondary">
                        Cancel
                    </a>
                </div>
            </div>

        </div>
    </form>

            
</div>

   